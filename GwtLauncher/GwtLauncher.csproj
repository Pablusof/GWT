<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\..\Ground War Tanks\GameIcon.ico</ApplicationIcon>
    <PlayerEdition Condition="'$(PlayerEdition)' == ''">false</PlayerEdition>
    <AssemblyName Condition="'$(PlayerEdition)' == 'true'">GWT_Launcher_Player</AssemblyName>
    <AssemblyName Condition="'$(PlayerEdition)' != 'true'">GWT_Launcher</AssemblyName>
    <DefineConstants Condition="'$(PlayerEdition)' == 'true'">$(DefineConstants);PLAYER_EDITION</DefineConstants>
    <RootNamespace>GwtLauncher</RootNamespace>
    <Version>1.4.1</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\hero_banner.jpg" />
  </ItemGroup>

</Project>
